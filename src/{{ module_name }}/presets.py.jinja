"""Presets for {{ project_name }}.

A preset is a function returning a validated ``RunConfig``. Variants are *arguments*, not
files — `dsio run {{ module_name }}_baseline seed=7` needs nothing checked in. That is why
this repo has no tree of config files to keep in sync.

Discovery imports ``{{ module_name }}.presets`` automatically, so anything decorated with
``@preset`` here is runnable from the CLI.
"""

from __future__ import annotations

from dsio.config import RunConfig, preset
from dsio.train.tabular import TabularTask


@preset
def {{ module_name }}_baseline(
    dataset: str = "breast_cancer",
    estimator: str = "logreg",
    seed: int = 42,
) -> RunConfig:
    """Starter baseline. Replace the task with your own once you have data staged."""
    return RunConfig(
        name=f"{{ module_name }}-{estimator}",
        seed=seed,
        tags=("baseline",),
        task=TabularTask(dataset=dataset, estimator=estimator),
    )
